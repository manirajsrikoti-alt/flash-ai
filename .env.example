# FLASH AI — Environment Configuration Template
# Copy this file to .env or export these variables in your shell environment.
# Note: Local fast-path commands and intent classification work without AWS.
# AWS credentials are only required for conversational Q&A and multi-step AI planning.

# ------------------------------------------------------------------------------
# AWS Bedrock Configuration (Conversational Brain & Task Planner)
# ------------------------------------------------------------------------------
# Your AWS Access Key ID and Secret Access Key
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Region where Amazon Bedrock is enabled (default: us-east-1)
FLASH_AWS_REGION=us-east-1

# Amazon Bedrock Model ID (default: us.amazon.nova-2-lite-v1:0)
FLASH_BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0

# ------------------------------------------------------------------------------
# Voice & Audio Configuration
# ------------------------------------------------------------------------------
# Silence timeout in seconds for voice activity detection (VAD).
# Default: 0.5 (500 ms). Recommended range: 0.45 - 0.60.
FLASH_SILENCE_SECONDS=0.5
